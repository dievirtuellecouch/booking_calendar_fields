{
    "name": "dvc/booking_calendar_fields",
    "description": "Adds accessible booking calendar and booking time fields to the Contao form generator.",
    "keywords": [
        "contao",
        "contao-bundle",
        "form",
        "booking",
        "calendar"
    ],
    "type": "contao-bundle",
    "license": "LGPL-3.0-or-later",
    "homepage": "https://github.com/dievirtuellecouch/booking_calendar_fields",
    "support": {
        "issues": "https://github.com/dievirtuellecouch/booking_calendar_fields/issues",
        "source": "https://github.com/dievirtuellecouch/booking_calendar_fields"
    },
    "authors": [
        {
            "name": "Timo Werlich",
            "email": "twe@d-v-c.net"
        }
    ],
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3.1",
        "contao/test-case": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "DVC\\BookingCalendarFields\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DVC\\BookingCalendarFields\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "contao-manager-plugin": "DVC\\BookingCalendarFields\\ContaoManager\\Plugin"
    }
}
