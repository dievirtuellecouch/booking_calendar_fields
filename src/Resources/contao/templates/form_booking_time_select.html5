<?php

$errorId = 'ctrl_' . $this->id . '_error';
$hasErrors = $this->hasErrors();

?>

<div
  class="<?= $this->getWrapperClass() ?>"
  data-label-floating="false"
  data-is-valid="<?= $hasErrors ? 'false' : 'null' ?>"
>
  <?php if ($this->label): ?>
    <label for="ctrl_<?= $this->id ?>" class="<?= $this->getLabelClass() ?>">
      <?php if ($this->mandatory): ?>
        <span class="invisible"><?= $this->mandatoryField ?> </span><?= $this->label ?><span class="mandatory">*</span>
      <?php else: ?>
        <?= $this->label ?>
      <?php endif; ?>
    </label>
  <?php endif; ?>

  <?php if ($hasErrors): ?>
    <p class="error booking-time-select__error" id="<?= $errorId ?>"><?= $this->getErrorAsString() ?></p>
  <?php endif; ?>

  <?php if ($this->multiple): ?>
    <input type="hidden" class="booking-time-select__empty-input" name="<?= str_ends_with($this->name, '[]') ? substr($this->name, 0, -2) : $this->name ?>" value="">
  <?php endif; ?>

  <select
    name="<?= $this->name ?>"
    id="ctrl_<?= $this->id ?>"
    class="<?= $this->getControlClass() ?>"
    <?php if ($hasErrors): ?>aria-describedby="<?= $errorId ?>"<?php endif; ?>
    <?= $this->getAttributes() ?>
  >
    <?php foreach ($this->getOptions() as $option): ?>
      <?php if ('group_start' == $option['type']): ?>
        <optgroup class="booking-time-select__group" label="<?= $option['label'] ?>">
      <?php endif; ?>

      <?php if ('option' == $option['type']): ?>
        <option class="booking-time-select__option" value="<?= $option['value'] ?>"<?= $option['selected'] ?>><?= $option['label'] ?></option>
      <?php endif; ?>

      <?php if ('group_end' == $option['type']): ?>
        </optgroup>
      <?php endif; ?>
    <?php endforeach; ?>
  </select>
</div>
